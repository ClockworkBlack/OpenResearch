{
  "name": "OpenResearch MCP server",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "pip install --user ddgs pypdf",
  "forwardPorts": [
    8765
  ],
  "portsAttributes": {
    "8765": {
      "label": "OpenResearch MCP",
      "onAutoForward": "silent"
    }
  },
  "secrets": {
    "OPENRESEARCH_TOKEN": {
      "description": "A long random secret. Your connector URL ends in /mcp/<this secret>. The server will not start without it."
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "task.allowAutomaticTasks": "on"
      }
    }
  }
}
